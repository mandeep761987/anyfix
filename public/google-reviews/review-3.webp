<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 360" width="600" height="360">
    <defs>
      <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFFFFF"/>
        <stop offset="100%" stop-color="#F8FAFC"/>
      </linearGradient>
      <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
        <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#0F172A" flood-opacity="0.04"/>
      </filter>
    </defs>
    
    <rect width="600" height="360" rx="24" fill="url(#bg)"/>
    <rect x="0.5" y="0.5" width="599" height="359" rx="23.5" fill="none" stroke="#E2E8F0" stroke-width="1"/>

    <!-- Google G icon top right -->
    <g transform="translate(530, 24)">
      <path fill="#4285F4" d="M19.6 10.23c0-.82-.07-1.42-.25-2.05H10v3.72h5.5c-.15.96-.74 2.31-2.04 3.22v2.45h3.16c1.89-1.73 2.98-4.3 2.98-7.34z"/>
      <path fill="#34A853" d="M10 20c2.7 0 4.96-.89 6.62-2.42l-3.16-2.45c-.88.6-2.02 1.01-3.46 1.01-2.68 0-4.96-1.8-5.76-4.27H1.02v2.53C2.7 17.76 6.07 20 10 20z"/>
      <path fill="#FBBC05" d="M4.24 11.87c-.21-.6-.33-1.25-.33-1.87s.12-1.27.33-1.87V5.6H1.02C.37 6.91 0 8.41 0 10s.37 3.09 1.02 4.4l3.22-2.53z"/>
      <path fill="#EA4335" d="M10 3.88c1.88 0 3.13.81 3.85 1.48l2.84-2.76C14.95.99 12.7 0 10 0 6.07 0 2.7 2.24 1.02 5.6l3.22 2.53c.8-2.47 3.08-4.25 5.76-4.25z"/>
    </g>

    <!-- User Avatar & Info -->
    <circle cx="56" cy="60" r="26" fill="#D97706"/>
    <text x="56" y="67" font-family="system-ui, -apple-system, sans-serif" font-size="18" font-weight="700" fill="#FFFFFF" text-anchor="middle">AV</text>
    
    <text x="96" y="52" font-family="system-ui, -apple-system, sans-serif" font-size="17" font-weight="700" fill="#0F172A">Aman Verma</text>
    <text x="96" y="72" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="500" fill="#64748B">Local Guide · 114 reviews · <tspan fill="#94A3B8">2 weeks ago</tspan></text>

    <!-- Stars -->
    <g transform="translate(30, 106)">
      
        <polygon points="12,2 15,8 22,9 17,14 18,21 12,17 6,21 7,14 2,9 9,8" transform="translate(0, 0)" fill="#FBBC04"/>
      
        <polygon points="12,2 15,8 22,9 17,14 18,21 12,17 6,21 7,14 2,9 9,8" transform="translate(25, 0)" fill="#FBBC04"/>
      
        <polygon points="12,2 15,8 22,9 17,14 18,21 12,17 6,21 7,14 2,9 9,8" transform="translate(50, 0)" fill="#FBBC04"/>
      
        <polygon points="12,2 15,8 22,9 17,14 18,21 12,17 6,21 7,14 2,9 9,8" transform="translate(75, 0)" fill="#FBBC04"/>
      
        <polygon points="12,2 15,8 22,9 17,14 18,21 12,17 6,21 7,14 2,9 9,8" transform="translate(100, 0)" fill="#FBBC04"/>
      
      <text x="140" y="16" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="700" fill="#0F172A">Verified Customer</text>
    </g>

    <!-- Review Text -->
    <foreignObject x="30" y="146" width="540" height="120">
      <div xmlns="http://www.w3.org/1999/xhtml" style="font-family: system-ui, -apple-system, sans-serif; font-size: 16px; line-height: 1.5; color: #334155; font-weight: 450;">
        &ldquo;Got OnePlus 11 display fixed at my Cyber City office. Super fast, transparent pricing and 6 months warranty card given.&rdquo;
      </div>
    </foreignObject>

    <!-- Bottom Tag -->
    <rect x="30" y="294" width="220" height="32" rx="16" fill="#EEF2FF"/>
    <text x="44" y="315" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="600" fill="#3730A3">✔ Repaired: OnePlus 11 Display</text>
  </svg>